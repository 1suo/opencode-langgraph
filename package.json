{
  "name": "opencode-langgraph",
  "version": "0.6.4",
  "description": "Explicit LangGraph connector for OpenCode",
  "type": "module",
  "bin": {
    "opencode-langgraph": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/core/index.js",
    "./server": "./dist/src/opencode/server.js",
    "./tui": "./dist/src/opencode/tui.js"
  },
  "files": [
    "dist/",
    "README.md",
    "PLAN.md",
    "SPEC-graph.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-tui.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "prepack": "npm run check && npm run build",
    "release": "node dist/src/release.js"
  },
  "keywords": [
    "ai",
    "agents",
    "langgraph",
    "opencode",
    "connector",
    "code-generation",
    "tui"
  ],
  "author": "1suo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1suo/opencode-langgraph.git"
  },
  "homepage": "https://github.com/1suo/opencode-langgraph#readme",
  "bugs": {
    "url": "https://github.com/1suo/opencode-langgraph/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.16 <2"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.9",
    "@opencode-ai/plugin": "1.18.16",
    "@opentui/core": "^0.5.2",
    "@opentui/solid": "^0.5.2",
    "commander": "^15.0.0",
    "jiti": "^2.6.1",
    "solid-js": "1.9.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@types/node": "^24.10.0",
    "babel-preset-solid": "1.9.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
