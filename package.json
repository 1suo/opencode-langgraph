{
  "name": "neolit",
  "version": "0.2.0",
  "description": "Progressive-cooling orchestration for constrained AI code generation",
  "type": "module",
  "bin": {
    "neolit": "dist/src/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "PLAN.md",
    "neolit.config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "demo": "tsx scripts/demo.ts",
    "prepack": "npm run check && npm run build",
    "release": "node dist/src/release.js"
  },
  "keywords": ["ai", "agents", "langgraph", "code-generation", "tui"],
  "author": "1suo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "beautiful-mermaid": "^1.1.3",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
