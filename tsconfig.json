{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/core/**/*.ts", "src/opencode/**/*.ts", "src/opencode/**/*.tsx", "src/cli.ts", "src/release.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
